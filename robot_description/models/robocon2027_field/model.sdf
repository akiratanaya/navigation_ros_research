<?xml version="1.0" ?>
<sdf version="1.8">
  <model name="robocon2027_field">
    <static>true</static>
    
    <!-- ============================================================== -->
    <!-- 1. ARENA FLOOR (11000mm x 11000mm, Red & Blue Zones)           -->
    <!-- ============================================================== -->
    <link name='floor_red'>
      <pose>-2.7500 0.0000 -0.0100 0 0 0</pose>
      <collision name='floor_red_col'>
        <geometry><box><size>5.5000 11.0000 0.0200</size></box></geometry>
      </collision>
      <visual name='floor_red_vis'>
        <geometry><box><size>5.5000 11.0000 0.0200</size></box></geometry>
        <material>
          <ambient>1.000 0.880 0.880 1.000</ambient>
          <diffuse>1.000 0.880 0.880 1.000</diffuse>
          <specular>0.1 0.1 0.1 1.0</specular>
        </material>
      </visual>
