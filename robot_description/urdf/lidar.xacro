<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" xmlns:gz="http://gazebosim.org/schema">

    <xacro:macro name="turtlebot_lidar" params="parent_link:=base_link">
        <xacro:property name="PI" value="3.1415926535897931" />
        <xacro:property name="lidar_radius" value="0.040" />
        <xacro:property name="lidar_height" value="0.058" />
        <xacro:property name="lidar_mass" value="0.12" />

        <!-- Physical link silinder LiDAR -->
        <link name="lidar_link">
            <visual>
                <origin xyz="0 0 ${lidar_height/2}" rpy="0 0 0" />
                <geometry>
                    <cylinder radius="${lidar_radius}" length="${lidar_height}" />
                </geometry>
                <material name="black" />
            </visual>
            <collision>
                <origin xyz="0 0 ${lidar_height/2}" rpy="0 0 0" />
                <geometry>
                    <cylinder radius="${lidar_radius}" length="${lidar_height}" />
                </geometry>
            </collision>
            <inertial>
                <origin xyz="0 0 ${lidar_height/2}" />
                <mass value="${lidar_mass}" />
                <inertia ixx="${(1.0/12.0)*lidar_mass*(3*lidar_radius*lidar_radius + lidar_height*lidar_height)}"
                                 ixy="0" ixz="0"
                                 iyy="${(1.0/12.0)*lidar_mass*(3*lidar_radius*lidar_radius + lidar_height*lidar_height)}"
                                 iyz="0"
                                 izz="${(1.0/2.0)*lidar_mass*lidar_radius*lidar_radius}" />
            </inertial>
        </link>

        <!-- Joint menghubungkan lidar ke bodi robot -->
        <joint name="lidar_joint" type="fixed">
            <parent link="${parent_link}" />
            <child link="lidar_link" />
            <!-- z = tinggi chassis (0.070) + wheel_radius (0.033) + sedikit offset = ~0.184 -->
            <origin xyz="0.0 0.0 0.184" rpy="0 0 0" />
        </joint>

        <!-- Frame aliases agar RViz2 TF tree mengenali semua kemungkinan frame Gazebo -->
        <link name="autonav_bot/lidar_link/lidar" />
        <joint name="lidar_gz_frame_joint" type="fixed">
            <parent link="lidar_link" />
            <child link="autonav_bot/lidar_link/lidar" />
            <origin xyz="0 0 ${lidar_height/2}" rpy="0 0 0" />
        </joint>

        <link name="base_scan" />
        <joint name="scan_joint" type="fixed">
            <parent link="lidar_link" />
            <child link="base_scan" />
            <origin xyz="0 0 ${lidar_height/2}" rpy="0 0 0" />
        </joint>

        <!-- Instruksikan Gazebo Harmonic untuk TIDAK menggabungkan joint ini -->
        <gazebo reference="lidar_joint">
            <preserveFixedJoint>true</preserveFixedJoint>
        </gazebo>

        <!-- Warna link LiDAR di Gazebo -->
        <gazebo reference="lidar_link">
            <material>Gazebo/FlatBlack</material>
        </gazebo>

        <!-- Sensor gpu_lidar -->
        <gazebo reference="lidar_link">
            <sensor name="lidar" type="gpu_lidar">
                <pose>0 0 ${lidar_height/2} 0 0 0</pose>
                <always_on>true</always_on>
                <visualize>true</visualize>
                <update_rate>10</update_rate>
                <topic>/scan</topic>
                <gz:frame_id>lidar_link</gz:frame_id>
                <frame_id>lidar_link</frame_id>
                <lidar>
                    <scan>
                        <horizontal>
                            <samples>360</samples>
                            <resolution>1</resolution>
                            <min_angle>${-PI}</min_angle>
                            <max_angle>${PI}</max_angle>
                        </horizontal>
                    </scan>
                    <range>
                        <min>0.120</min>
                        <max>12.0</max>
                        <resolution>0.015</resolution>
                    </range>
                    <noise>
                        <type>gaussian</type>
                        <mean>0.0</mean>
                        <stddev>0.01</stddev>
                    </noise>
                </lidar>
            </sensor>
        </gazebo>
    </xacro:macro>

</robot>