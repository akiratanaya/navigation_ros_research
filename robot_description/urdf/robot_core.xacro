<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <material name="dark_grey"><color rgba="0.18 0.19 0.21 1.0"/></material>
    <material name="mid_grey"><color rgba="0.45 0.48 0.52 1.0"/></material>
    <material name="light_grey"><color rgba="0.78 0.80 0.82 1.0"/></material>
    <material name="black"><color rgba="0.04 0.04 0.04 1.0"/></material>
    <material name="accent_orange"><color rgba="0.85 0.50 0.15 1.0"/></material>
    <material name="green_pcb"><color rgba="0.13 0.55 0.13 1.0"/></material>
    <material name="tread_dark"><color rgba="0.08 0.08 0.09 1.0"/></material>
    <material name="tank_armor"><color rgba="0.24 0.25 0.27 1.0"/></material>

    <xacro:macro name="turtlebot_core">
        <xacro:property name="PI" value="3.1415926535897931" />

        <!-- Chassis dimensions (Armored Tank style) -->
        <xacro:property name="base_x" value="0.300" />
        <xacro:property name="base_y" value="0.200" />
        <xacro:property name="base_z" value="0.080" />
        <xacro:property name="base_mass" value="7.00" />

        <!-- Tank Track Dimensions -->
        <xacro:property name="track_y_offset" value="0.135" /> <!-- Center of track: y = +/- 0.135 m -->
        <xacro:property name="track_width" value="0.046" />
        <xacro:property name="track_separation" value="0.270" /> <!-- 2 * track_y_offset -->

        <!-- Road Wheels (3 per side) -->
        <xacro:property name="road_radius" value="0.045" />
        <xacro:property name="road_width" value="0.044" />
        <xacro:property name="road_mass" value="0.06" />

        <!-- Front Sprocket & Rear Idler (Raised for climbing) -->
        <xacro:property name="sprocket_radius" value="0.038" />
        <xacro:property name="sprocket_width" value="0.044" />
        <xacro:property name="sprocket_mass" value="0.05" />
        <xacro:property name="sprocket_x" value="0.142" />
        <xacro:property name="sprocket_z" value="0.016" />

        <!-- Top plate & standoffs for sensors -->
        <xacro:property name="standoff_radius" value="0.008" />
        <xacro:property name="standoff_height" value="0.095" />

        <xacro:property name="plate_x" value="0.260" />
        <xacro:property name="plate_y" value="0.200" />
        <xacro:property name="plate_z" value="0.006" />
        <xacro:property name="plate_mass" value="0.20" />

        <!-- Base Footprint: Projected on the ground plane -->
        <link name="base_footprint" />

        <joint name="base_footprint_joint" type="fixed">
            <parent link="base_footprint" />
            <child link="base_link" />
            <origin xyz="0.0 0.0 ${road_radius}" rpy="0 0 0" />
        </joint>

        <!-- Base Link: Heavy-Duty Tank Chassis with Integrated Caterpillar Track Belts -->
        <link name="base_link">
            <!-- Main Armored Hull -->
            <visual>
                <origin xyz="0.0 0.0 ${base_z/2}" rpy="0 0 0" />
                <geometry>
                    <box size="${base_x} ${base_y} ${base_z}" />
                </geometry>
                <material name="tank_armor" />
            </visual>

            <!-- Front Sloped Glacis Armor Plate -->
            <visual>
                <origin xyz="${base_x/2 - 0.015} 0.0 ${base_z/2}" rpy="0 0.65 0" />
                <geometry>
                    <box size="0.050 ${base_y - 0.004} ${base_z - 0.004}" />
                </geometry>
                <material name="accent_orange" />
            </visual>

            <!-- ================= LEFT TANK TRACK VISUALS ================= -->
            <!-- Left Track: Bottom Flat Belt (ground contact) -->
            <visual>
                <origin xyz="0.0 ${track_y_offset} ${-road_radius + 0.004}" rpy="0 0 0" />
                <geometry>
                    <box size="0.150 ${track_width} 0.008" />
                </geometry>
                <material name="tread_dark" />
            </visual>
            <!-- Left Track: Top Flat Belt -->
            <visual>
                <origin xyz="0.0 ${track_y_offset} ${sprocket_z + sprocket_radius - 0.004}" rpy="0 0 0" />
                <geometry>
                    <box size="0.284 ${track_width} 0.008" />
                </geometry>
                <material name="tread_dark" />
            </visual>
            <!-- Left Track: Front Climbing Slope -->
            <visual>
                <origin xyz="0.108 ${track_y_offset} 0.005" rpy="0 -0.85 0" />
                <geometry>
                    <box size="0.114 ${track_width} 0.008" />
                </geometry>
                <material name="tread_dark" />
            </visual>
            <!-- Left Track: Rear Slope -->
            <visual>
                <origin xyz="-0.108 ${track_y_offset} 0.005" rpy="0 0.85 0" />
                <geometry>
                    <box size="0.114 ${track_width} 0.008" />
                </geometry>
                <material name="tread_dark" />
            </visual>
            <!-- Left Track: Front Nose Cap -->
            <visual>
                <origin xyz="${sprocket_x} ${track_y_offset} ${sprocket_z}" rpy="${PI/2} 0 0" />
                <geometry>
                    <cylinder radius="${sprocket_radius + 0.002}" length="${track_width}" />
                </geometry>
                <material name="tread_dark" />
            </visual>
            <!-- Left Track: Rear Tail Cap -->
            <visual>
                <origin xyz="${-sprocket_x} ${track_y_offset} ${sprocket_z}" rpy="${PI/2} 0 0" />
                <geometry>
                    <cylinder radius="${sprocket_radius + 0.002}" length="${track_width}" />
                </geometry>
                <material name="tread_dark" />
            </visual>

            <!-- Left Track: Cleats / Grousers on Top Belt -->
            <visual><origin xyz="-0.120 ${track_y_offset} ${sprocket_z + sprocket_radius + 0.002}" rpy="0 0 0" /><geometry><box size="0.008 ${track_width + 0.002} 0.004" /></geometry><material name="black" /></visual>
            <visual><origin xyz="-0.085 ${track_y_offset} ${sprocket_z + sprocket_radius + 0.002}" rpy="0 0 0" /><geometry><box size="0.008 ${track_width + 0.002} 0.004" /></geometry><material name="black" /></visual>
            <visual><origin xyz="-0.050 ${track_y_offset} ${sprocket_z + sprocket_radius + 0.002}" rpy="0 0 0" /><geometry><box size="0.008 ${track_width + 0.002} 0.004" /></geometry><material name="black" /></visual>
            <visual><origin xyz="-0.017 ${track_y_offset} ${sprocket_z + sprocket_radius + 0.002}" rpy="0 0 0" /><geometry><box size="0.008 ${track_width + 0.002} 0.004" /></geometry><material name="black" /></visual>
            <visual><origin xyz="0.017 ${track_y_offset} ${sprocket_z + sprocket_radius + 0.002}" rpy="0 0 0" /><geometry><box size="0.008 ${track_width + 0.002} 0.004" /></geometry><material name="black" /></visual>
            <visual><origin xyz="0.050 ${track_y_offset} ${sprocket_z + sprocket_radius + 0.002}" rpy="0 0 0" /><geometry><box size="0.008 ${track_width + 0.002} 0.004" /></geometry><material name="black" /></visual>
            <visual><origin xyz="0.085 ${track_y_offset} ${sprocket_z + sprocket_radius + 0.002}" rpy="0 0 0" /><geometry><box size="0.008 ${track_width + 0.002} 0.004" /></geometry><material name="black" /></visual>
            <visual><origin xyz="0.120 ${track_y_offset} ${sprocket_z + sprocket_radius + 0.002}" rpy="0 0 0" /><geometry><box size="0.008 ${track_width + 0.002} 0.004" /></geometry><material name="black" /></visual>

            <!-- Left Track: Mudguard / Fender -->
            <visual>
                <origin xyz="0.0 ${track_y_offset} 0.060" rpy="0 0 0" />
                <geometry>
                    <box size="0.300 ${track_width + 0.010} 0.004" />
                </geometry>
                <material name="mid_grey" />
            </visual>
            <visual>
                <origin xyz="0.165 ${track_y_offset} 0.050" rpy="0 0.50 0" />
                <geometry>
                    <box size="0.045 ${track_width + 0.010} 0.004" />
                </geometry>
                <material name="mid_grey" />
            </visual>
            <visual>
                <origin xyz="-0.165 ${track_y_offset} 0.050" rpy="0 -0.50 0" />
                <geometry>
                    <box size="0.045 ${track_width + 0.010} 0.004" />
                </geometry>
                <material name="mid_grey" />
            </visual>
            <visual>
                <origin xyz="0.0 ${track_y_offset + track_width/2 + 0.004} 0.048" rpy="0 0 0" />
                <geometry>
                    <box size="0.280 0.003 0.020" />
                </geometry>
                <material name="mid_grey" />
            </visual>

            <!-- ================= RIGHT TANK TRACK VISUALS ================= -->
            <!-- Right Track: Bottom Flat Belt -->
            <visual>
                <origin xyz="0.0 ${-track_y_offset} ${-road_radius + 0.004}" rpy="0 0 0" />
                <geometry>
                    <box size="0.150 ${track_width} 0.008" />
                </geometry>
                <material name="tread_dark" />
            </visual>
            <!-- Right Track: Top Flat Belt -->
            <visual>
                <origin xyz="0.0 ${-track_y_offset} ${sprocket_z + sprocket_radius - 0.004}" rpy="0 0 0" />
                <geometry>
                    <box size="0.284 ${track_width} 0.008" />
                </geometry>
                <material name="tread_dark" />
            </visual>
            <!-- Right Track: Front Climbing Slope -->
            <visual>
                <origin xyz="0.108 ${-track_y_offset} 0.005" rpy="0 -0.85 0" />
                <geometry>
                    <box size="0.114 ${track_width} 0.008" />
                </geometry>
                <material name="tread_dark" />
            </visual>
            <!-- Right Track: Rear Slope -->
            <visual>
                <origin xyz="-0.108 ${-track_y_offset} 0.005" rpy="0 0.85 0" />
                <geometry>
                    <box size="0.114 ${track_width} 0.008" />
                </geometry>
                <material name="tread_dark" />
            </visual>
            <!-- Right Track: Front Nose Cap -->
            <visual>
                <origin xyz="${sprocket_x} ${-track_y_offset} ${sprocket_z}" rpy="${PI/2} 0 0" />
                <geometry>
                    <cylinder radius="${sprocket_radius + 0.002}" length="${track_width}" />
                </geometry>
                <material name="tread_dark" />
            </visual>
            <!-- Right Track: Rear Tail Cap -->
            <visual>
                <origin xyz="${-sprocket_x} ${-track_y_offset} ${sprocket_z}" rpy="${PI/2} 0 0" />
                <geometry>
                    <cylinder radius="${sprocket_radius + 0.002}" length="${track_width}" />
                </geometry>
                <material name="tread_dark" />
            </visual>

            <!-- Right Track: Cleats / Grousers on Top Belt -->
            <visual><origin xyz="-0.120 ${-track_y_offset} ${sprocket_z + sprocket_radius + 0.002}" rpy="0 0 0" /><geometry><box size="0.008 ${track_width + 0.002} 0.004" /></geometry><material name="black" /></visual>
            <visual><origin xyz="-0.085 ${-track_y_offset} ${sprocket_z + sprocket_radius + 0.002}" rpy="0 0 0" /><geometry><box size="0.008 ${track_width + 0.002} 0.004" /></geometry><material name="black" /></visual>
            <visual><origin xyz="-0.050 ${-track_y_offset} ${sprocket_z + sprocket_radius + 0.002}" rpy="0 0 0" /><geometry><box size="0.008 ${track_width + 0.002} 0.004" /></geometry><material name="black" /></visual>
            <visual><origin xyz="-0.017 ${-track_y_offset} ${sprocket_z + sprocket_radius + 0.002}" rpy="0 0 0" /><geometry><box size="0.008 ${track_width + 0.002} 0.004" /></geometry><material name="black" /></visual>
            <visual><origin xyz="0.017 ${-track_y_offset} ${sprocket_z + sprocket_radius + 0.002}" rpy="0 0 0" /><geometry><box size="0.008 ${track_width + 0.002} 0.004" /></geometry><material name="black" /></visual>
            <visual><origin xyz="0.050 ${-track_y_offset} ${sprocket_z + sprocket_radius + 0.002}" rpy="0 0 0" /><geometry><box size="0.008 ${track_width + 0.002} 0.004" /></geometry><material name="black" /></visual>
            <visual><origin xyz="0.085 ${-track_y_offset} ${sprocket_z + sprocket_radius + 0.002}" rpy="0 0 0" /><geometry><box size="0.008 ${track_width + 0.002} 0.004" /></geometry><material name="black" /></visual>
            <visual><origin xyz="0.120 ${-track_y_offset} ${sprocket_z + sprocket_radius + 0.002}" rpy="0 0 0" /><geometry><box size="0.008 ${track_width + 0.002} 0.004" /></geometry><material name="black" /></visual>

            <!-- Right Track: Mudguard / Fender -->
            <visual>
                <origin xyz="0.0 ${-track_y_offset} 0.060" rpy="0 0 0" />
                <geometry>
                    <box size="0.300 ${track_width + 0.010} 0.004" />
                </geometry>
                <material name="mid_grey" />
            </visual>
            <visual>
                <origin xyz="0.165 ${-track_y_offset} 0.050" rpy="0 0.50 0" />
                <geometry>
                    <box size="0.045 ${track_width + 0.010} 0.004" />
                </geometry>
                <material name="mid_grey" />
            </visual>
            <visual>
                <origin xyz="-0.165 ${-track_y_offset} 0.050" rpy="0 -0.50 0" />
                <geometry>
                    <box size="0.045 ${track_width + 0.010} 0.004" />
                </geometry>
                <material name="mid_grey" />
            </visual>
            <visual>
                <origin xyz="0.0 ${-(track_y_offset + track_width/2 + 0.004)} 0.048" rpy="0 0 0" />
                <geometry>
                    <box size="0.280 0.003 0.020" />
                </geometry>
                <material name="mid_grey" />
            </visual>

            <!-- Chassis Collision (raised to avoid dragging on ground or ramps) -->
            <collision>
                <origin xyz="0.0 0.0 ${base_z/2 + 0.005}" rpy="0 0 0" />
                <geometry>
                    <box size="${base_x - 0.02} ${base_y} ${base_z - 0.01}" />
                </geometry>
            </collision>

            <inertial>
                <origin xyz="0.0 0.0 0.01" rpy="0 0 0" />
                <mass value="${base_mass}" />
                <inertia ixx="${(1.0/12.0)*base_mass*(base_y*base_y + base_z*base_z)}"
                         ixy="0.0" ixz="0.0"
                         iyy="${(1.0/12.0)*base_mass*(base_x*base_x + base_z*base_z)}"
                         iyz="0.0"
                         izz="${(1.0/12.0)*base_mass*(base_x*base_x + base_y*base_y)}" />
            </inertial>
        </link>

        <!-- ================= MACRO: TANK ROAD WHEEL ================= -->
        <xacro:macro name="road_wheel" params="prefix suffix x_pos y_reflect">
            <link name="wheel_${prefix}_${suffix}_link">
                <!-- Outer Rubber Roller Wheel -->
                <visual>
                    <origin xyz="0 0 0" rpy="${PI/2} 0 0" />
                    <geometry>
                        <cylinder radius="${road_radius}" length="${road_width - 0.004}" />
                    </geometry>
                    <material name="tread_dark" />
                </visual>
                <!-- Metallic Wheel Rim Disc (High Contrast) -->
                <visual>
                    <origin xyz="0 ${y_reflect * (road_width/2 - 0.001)} 0" rpy="${PI/2} 0 0" />
                    <geometry>
                        <cylinder radius="${road_radius * 0.78}" length="0.003" />
                    </geometry>
                    <material name="light_grey" />
                </visual>
                <!-- Tank Wheel Hubcap (Outer face) -->
                <visual>
                    <origin xyz="0 ${y_reflect * (road_width/2 + 0.001)} 0" rpy="${PI/2} 0 0" />
                    <geometry>
                        <cylinder radius="${road_radius * 0.45}" length="0.003" />
                    </geometry>
                    <material name="accent_orange" />
                </visual>
                <!-- Central Axle Bolt -->
                <visual>
                    <origin xyz="0 ${y_reflect * (road_width/2 + 0.003)} 0" rpy="${PI/2} 0 0" />
                    <geometry>
                        <cylinder radius="${road_radius * 0.18}" length="0.002" />
                    </geometry>
                    <material name="black" />
                </visual>
                <collision>
                    <origin xyz="0 0 0" rpy="${PI/2} 0 0" />
                    <geometry>
                        <cylinder radius="${road_radius}" length="${road_width}" />
                    </geometry>
                </collision>
                <inertial>
                    <origin xyz="0 0 0" />
                    <mass value="${road_mass}" />
                    <inertia ixx="${(1.0/12.0)*road_mass*(3*road_radius*road_radius + road_width*road_width)}"
                             ixy="0" ixz="0"
                             iyy="${(1.0/12.0)*road_mass*(3*road_radius*road_radius + road_width*road_width)}"
                             iyz="0"
                             izz="${(1.0/2.0)*road_mass*road_radius*road_radius}" />
                </inertial>
            </link>

            <joint name="wheel_${prefix}_${suffix}_joint" type="continuous">
                <parent link="base_link" />
                <child link="wheel_${prefix}_${suffix}_link" />
                <origin xyz="${x_pos} ${y_reflect * track_y_offset} 0.0" rpy="0 0 0" />
                <axis xyz="0 1 0" />
                <dynamics damping="0.01" friction="0.05" />
            </joint>

            <gazebo reference="wheel_${prefix}_${suffix}_link">
                <mu1>1.5</mu1>
                <mu2>0.1</mu2>
                <kp>1000000.0</kp>
                <kd>1.0</kd>
                <minDepth>0.001</minDepth>
            </gazebo>
        </xacro:macro>

        <!-- ================= MACRO: SPROCKET / IDLER WHEEL ================= -->
        <xacro:macro name="end_wheel" params="type prefix x_pos z_pos y_reflect">
            <link name="${type}_${prefix}_link">
                <!-- Sprocket / Idler Wheel Body -->
                <visual>
                    <origin xyz="0 0 0" rpy="${PI/2} 0 0" />
                    <geometry>
                        <cylinder radius="${sprocket_radius}" length="${sprocket_width - 0.004}" />
                    </geometry>
                    <material name="tread_dark" />
                </visual>
                <!-- Metallic Wheel Rim Disc -->
                <visual>
                    <origin xyz="0 ${y_reflect * (sprocket_width/2 - 0.001)} 0" rpy="${PI/2} 0 0" />
                    <geometry>
                        <cylinder radius="${sprocket_radius * 0.78}" length="0.003" />
                    </geometry>
                    <material name="light_grey" />
                </visual>
                <!-- Outer Hubcap -->
                <visual>
                    <origin xyz="0 ${y_reflect * (sprocket_width/2 + 0.001)} 0" rpy="${PI/2} 0 0" />
                    <geometry>
                        <cylinder radius="${sprocket_radius * 0.45}" length="0.003" />
                    </geometry>
                    <material name="accent_orange" />
                </visual>
                <visual>
                    <origin xyz="0 ${y_reflect * (sprocket_width/2 + 0.003)} 0" rpy="${PI/2} 0 0" />
                    <geometry>
                        <cylinder radius="${sprocket_radius * 0.18}" length="0.002" />
                    </geometry>
                    <material name="black" />
                </visual>
                <collision>
                    <origin xyz="0 0 0" rpy="${PI/2} 0 0" />
                    <geometry>
                        <cylinder radius="${sprocket_radius}" length="${sprocket_width}" />
                    </geometry>
                </collision>
                <inertial>
                    <origin xyz="0 0 0" />
                    <mass value="${sprocket_mass}" />
                    <inertia ixx="${(1.0/12.0)*sprocket_mass*(3*sprocket_radius*sprocket_radius + sprocket_width*sprocket_width)}"
                             ixy="0" ixz="0"
                             iyy="${(1.0/12.0)*sprocket_mass*(3*sprocket_radius*sprocket_radius + sprocket_width*sprocket_width)}"
                             iyz="0"
                             izz="${(1.0/2.0)*sprocket_mass*sprocket_radius*sprocket_radius}" />
                </inertial>
            </link>

            <joint name="${type}_${prefix}_joint" type="continuous">
                <parent link="base_link" />
                <child link="${type}_${prefix}_link" />
                <origin xyz="${x_pos} ${y_reflect * track_y_offset} ${z_pos}" rpy="0 0 0" />
                <axis xyz="0 1 0" />
                <dynamics damping="0.01" friction="0.05" />
            </joint>

            <gazebo reference="${type}_${prefix}_link">
                <mu1>1.5</mu1>
                <mu2>0.1</mu2>
                <kp>1000000.0</kp>
                <kd>1.0</kd>
                <minDepth>0.001</minDepth>
            </gazebo>
        </xacro:macro>

        <!-- Instantiate 3 Road Wheels on Left -->
        <xacro:road_wheel prefix="front" suffix="left"  x_pos="0.075"  y_reflect="1" />
        <xacro:road_wheel prefix="mid"   suffix="left"  x_pos="0.000"  y_reflect="1" />
        <xacro:road_wheel prefix="back"  suffix="left"  x_pos="-0.075" y_reflect="1" />

        <!-- Instantiate 3 Road Wheels on Right -->
        <xacro:road_wheel prefix="front" suffix="right" x_pos="0.075"  y_reflect="-1" />
        <xacro:road_wheel prefix="mid"   suffix="right" x_pos="0.000"  y_reflect="-1" />
        <xacro:road_wheel prefix="back"  suffix="right" x_pos="-0.075" y_reflect="-1" />

        <!-- Instantiate Front Sprockets & Rear Idlers -->
        <xacro:end_wheel type="sprocket" prefix="front_left"  x_pos="${sprocket_x}"  z_pos="${sprocket_z}" y_reflect="1" />
        <xacro:end_wheel type="sprocket" prefix="front_right" x_pos="${sprocket_x}"  z_pos="${sprocket_z}" y_reflect="-1" />
        <xacro:end_wheel type="idler"    prefix="back_left"   x_pos="${-sprocket_x}" z_pos="${sprocket_z}" y_reflect="1" />
        <xacro:end_wheel type="idler"    prefix="back_right"  x_pos="${-sprocket_x}" z_pos="${sprocket_z}" y_reflect="-1" />

        <!-- Standoffs for Sensor Deck -->
        <xacro:macro name="standoff" params="prefix x_pos y_pos">
            <link name="standoff_${prefix}_link">
                <visual>
                    <origin xyz="0 0 ${standoff_height/2}" rpy="0 0 0" />
                    <geometry>
                        <cylinder radius="${standoff_radius}" length="${standoff_height}" />
                    </geometry>
                    <material name="light_grey" />
                </visual>
                <collision>
                    <origin xyz="0 0 ${standoff_height/2}" rpy="0 0 0" />
                    <geometry>
                        <cylinder radius="${standoff_radius}" length="${standoff_height}" />
                    </geometry>
                </collision>
                <inertial>
                    <origin xyz="0 0 ${standoff_height/2}" />
                    <mass value="0.02" />
                    <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.000001" />
                </inertial>
            </link>

            <joint name="standoff_${prefix}_joint" type="fixed">
                <parent link="base_link" />
                <child link="standoff_${prefix}_link" />
                <origin xyz="${x_pos} ${y_pos} ${base_z}" rpy="0 0 0" />
            </joint>
        </xacro:macro>

        <xacro:standoff prefix="front_left"  x_pos="${plate_x/2 - 0.020}" y_pos="${plate_y/2 - 0.020}" />
        <xacro:standoff prefix="front_right" x_pos="${plate_x/2 - 0.020}" y_pos="${-(plate_y/2 - 0.020)}" />
        <xacro:standoff prefix="back_left"   x_pos="${-(plate_x/2 - 0.020)}" y_pos="${plate_y/2 - 0.020}" />
        <xacro:standoff prefix="back_right"  x_pos="${-(plate_x/2 - 0.020)}" y_pos="${-(plate_y/2 - 0.020)}" />

        <!-- Sensor Deck / Top Plate -->
        <link name="top_plate_link">
            <visual>
                <origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
                <geometry>
                    <box size="${plate_x} ${plate_y} ${plate_z}" />
                </geometry>
                <material name="green_pcb" />
            </visual>
            <collision>
                <origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
                <geometry>
                    <box size="${plate_x} ${plate_y} ${plate_z}" />
                </geometry>
            </collision>
            <inertial>
                <origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
                <mass value="${plate_mass}" />
                <inertia ixx="${(1.0/12.0)*plate_mass*(plate_y*plate_y + plate_z*plate_z)}"
                         ixy="0.0" ixz="0.0"
                         iyy="${(1.0/12.0)*plate_mass*(plate_x*plate_x + plate_z*plate_z)}"
                         iyz="0.0"
                         izz="${(1.0/12.0)*plate_mass*(plate_x*plate_x + plate_y*plate_y)}" />
            </inertial>
        </link>

        <joint name="top_plate_joint" type="fixed">
            <parent link="base_link" />
            <child link="top_plate_link" />
            <origin xyz="0.0 0.0 ${base_z + standoff_height + plate_z/2}" rpy="0 0 0" />
        </joint>

        <!-- GPS Antenna -->
        <link name="gps_link">
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry>
                    <cylinder radius="0.012" length="0.010" />
                </geometry>
                <material name="mid_grey" />
            </visual>
            <inertial>
                <origin xyz="0 0 0" />
                <mass value="0.005" />
                <inertia ixx="0.000001" ixy="0" ixz="0" iyy="0.000001" iyz="0" izz="0.000001" />
            </inertial>
        </link>

        <joint name="gps_joint" type="fixed">
            <parent link="top_plate_link" />
            <child link="gps_link" />
            <origin xyz="${plate_x/2 - 0.035} ${-(plate_y/2 - 0.035)} ${plate_z/2 + 0.005}" rpy="0 0 0" />
        </joint>

        <gazebo reference="top_plate_link"><material>Gazebo/Green</material></gazebo>

        <!-- Tank Skid-Steer / Differential Drive System Plugin -->
        <gazebo>
            <plugin
                filename="gz-sim-diff-drive-system"
                name="gz::sim::systems::DiffDrive">
                <!-- Left Driven Joints (3 road wheels + 2 sprockets) -->
                <left_joint>wheel_front_left_joint</left_joint>
                <left_joint>wheel_mid_left_joint</left_joint>
                <left_joint>wheel_back_left_joint</left_joint>
                <left_joint>sprocket_front_left_joint</left_joint>
                <left_joint>idler_back_left_joint</left_joint>
                <!-- Right Driven Joints (3 road wheels + 2 sprockets) -->
                <right_joint>wheel_front_right_joint</right_joint>
                <right_joint>wheel_mid_right_joint</right_joint>
                <right_joint>wheel_back_right_joint</right_joint>
                <right_joint>sprocket_front_right_joint</right_joint>
                <right_joint>idler_back_right_joint</right_joint>
                <wheel_separation>${track_separation}</wheel_separation>
                <wheel_radius>${road_radius}</wheel_radius>
                <max_wheel_torque>25.0</max_wheel_torque>
                <max_linear_acceleration>2.0</max_linear_acceleration>
                <min_linear_acceleration>-2.0</min_linear_acceleration>
                <max_angular_acceleration>3.0</max_angular_acceleration>
                <min_angular_acceleration>-3.0</min_angular_acceleration>
                <max_linear_velocity>1.2</max_linear_velocity>
                <min_linear_velocity>-1.2</min_linear_velocity>
                <max_angular_velocity>2.5</max_angular_velocity>
                <min_angular_velocity>-2.5</min_angular_velocity>
                <topic>/cmd_vel</topic>
                <odom_topic>/odom_wheel</odom_topic>
                <tf_topic>/tf_wheel</tf_topic>
                <frame_id>odom_wheel</frame_id>
                <child_frame_id>base_footprint</child_frame_id>
                <odom_publish_frequency>50</odom_publish_frequency>
            </plugin>
        </gazebo>

        <!-- Ground Truth Odometry Publisher (Eliminates skid-steer wheel slip from odometry) -->
        <gazebo>
            <plugin
                filename="gz-sim-odometry-publisher-system"
                name="gz::sim::systems::OdometryPublisher">
                <odom_frame>odom</odom_frame>
                <robot_base_frame>base_footprint</robot_base_frame>
                <odom_topic>/odom</odom_topic>
                <tf_topic>/tf</tf_topic>
                <odom_publish_frequency>50</odom_publish_frequency>
            </plugin>
        </gazebo>

        <!-- Joint State Publisher for all 10 Tank Wheels -->
        <gazebo>
            <plugin
                filename="gz-sim-joint-state-publisher-system"
                name="gz::sim::systems::JointStatePublisher">
                <topic>/joint_states</topic>
                <joint_name>wheel_front_left_joint</joint_name>
                <joint_name>wheel_mid_left_joint</joint_name>
                <joint_name>wheel_back_left_joint</joint_name>
                <joint_name>sprocket_front_left_joint</joint_name>
                <joint_name>idler_back_left_joint</joint_name>
                <joint_name>wheel_front_right_joint</joint_name>
                <joint_name>wheel_mid_right_joint</joint_name>
                <joint_name>wheel_back_right_joint</joint_name>
                <joint_name>sprocket_front_right_joint</joint_name>
                <joint_name>idler_back_right_joint</joint_name>
                <update_rate>30</update_rate>
            </plugin>
        </gazebo>
    </xacro:macro>

</robot>