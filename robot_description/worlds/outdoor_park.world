<?xml version="1.0"?>
<sdf version="1.8">
  <world name="default">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Essential Gazebo Harmonic Core Plugins -->
    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>
    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin
      filename="gz-sim-imu-system"
      name="gz::sim::systems::Imu">
    </plugin>

    <!-- Natural Outdoor Lighting and Sky -->
    <scene>
      <ambient>0.70 0.70 0.70 1.0</ambient>
      <background>0.65 0.80 0.95 1.0</background>
      <shadows>true</shadows>
      <grid>false</grid>
    </scene>

    <gui fullscreen='0'>
      <camera name='user_camera'>
        <pose>-10.0 -10.0 14.0 0 0.75 0.785</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>

    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Sun</uri>
    </include>

    <!-- Deep Safety Ground Plane Underneath Park Terrain -->
    <model name="safety_ground_plane">
      <static>true</static>
      <pose>0 0 -10.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>300 300</size>
            </plane>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- Realistic 3D Outdoor Park with Rolling Hills, Trees, Boulders & Pavilion -->
    <model name="outdoor_park">
      <static>true</static>
      <include>
        <uri>model://outdoor_park</uri>
      </include>
    </model>

  </world>
</sdf>
