    <!-- Red Ramp Slope: Solid Triangular Wedge ending at Y = 2.50m (flush with Level 1) -->
    <link name='ramp_red_slope'>
      <pose>-2.8000 0.0000 0.0000 0 0 0</pose>
      <collision name='ramp_red_slope_col'>
        <pose>0.0000 1.4472 0.1302 -0.141897 0 0</pose>
        <geometry><box><size>0.6000 2.1513 0.0400</size></box></geometry>
        <surface>
          <friction>
            <ode>
              <mu>50.0</mu>
              <mu2>50.0</mu2>
            </ode>
          </friction>
          <contact>
            <ode>
              <kp>1000000.0</kp>
              <kd>1.0</kd>
              <min_depth>0.001</min_depth>
            </ode>
          </contact>
        </surface>
      </collision>
      <visual name='ramp_red_slope_vis'>
