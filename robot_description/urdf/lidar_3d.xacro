<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" xmlns:gz="http://gazebosim.org/schema">

    <!--
        Macro LiDAR 3D — mensimulasikan Velodyne VLP-16 (16 channel)
        Output:
          /pointcloud       → sensor_msgs/msg/PointCloud2  (point cloud 3D)
          /pointcloud/scan  → sensor_msgs/msg/LaserScan    (proyeksi 2D dari layer tengah)

        Parameters:
          parent_link  : link tempat sensor dipasang (default: base_link)
          vlp16        : jika true, gunakan preset VLP-16 (16 layer ±15°)
                         jika false (generic 32-channel ±22.5°)
    -->
    <xacro:macro name="turtlebot_lidar_3d" params="parent_link:=base_link">
        <xacro:property name="PI"           value="3.1415926535897931" />
        <!-- Dimensi fisik silinder LiDAR 3D (mirip Velodyne VLP-16) -->
        <xacro:property name="lidar_radius" value="0.052" />
        <xacro:property name="lidar_height" value="0.072" />
        <xacro:property name="lidar_mass"   value="0.83" />

        <!-- ═══ LINK FISIK ══════════════════════════════════════════════════ -->
        <link name="lidar_3d_link">
            <visual>
                <origin xyz="0 0 ${lidar_height/2}" rpy="0 0 0" />
                <geometry>
                    <cylinder radius="${lidar_radius}" length="${lidar_height}" />
                </geometry>
                <material name="dark_grey" />
            </visual>
            <collision>
                <origin xyz="0 0 ${lidar_height/2}" rpy="0 0 0" />
                <geometry>
                    <cylinder radius="${lidar_radius}" length="${lidar_height}" />
                </geometry>
            </collision>
            <inertial>
                <origin xyz="0 0 ${lidar_height/2}" />
                <mass value="${lidar_mass}" />
                <inertia
                    ixx="${(1.0/12.0)*lidar_mass*(3*lidar_radius*lidar_radius + lidar_height*lidar_height)}"
                    ixy="0" ixz="0"
                    iyy="${(1.0/12.0)*lidar_mass*(3*lidar_radius*lidar_radius + lidar_height*lidar_height)}"
                    iyz="0"
                    izz="${(1.0/2.0)*lidar_mass*lidar_radius*lidar_radius}" />
            </inertial>
        </link>

        <!-- ═══ JOINT ═══════════════════════════════════════════════════════ -->
        <joint name="lidar_3d_joint" type="fixed">
            <parent link="${parent_link}" />
            <child link="lidar_3d_link" />
            <!-- z: sama dengan 2D LiDAR (di atas chassis) -->
            <origin xyz="0.0 0.0 0.184" rpy="0 0 0" />
        </joint>

        <!-- ═══ FRAME ALIAS untuk RViz2 TF ══════════════════════════════════ -->
        <!-- Gazebo Harmonic akan memberi nama frame: autonav_bot/lidar_3d_link/lidar_3d -->
        <link name="autonav_bot/lidar_3d_link/lidar_3d" />
        <joint name="lidar_3d_gz_frame_joint" type="fixed">
            <parent link="lidar_3d_link" />
            <child link="autonav_bot/lidar_3d_link/lidar_3d" />
            <origin xyz="0 0 ${lidar_height/2}" rpy="0 0 0" />
        </joint>

        <!-- ═══ GAZEBO: Preserve joint (tidak di-collapse) ══════════════════ -->
        <gazebo reference="lidar_3d_joint">
            <preserveFixedJoint>true</preserveFixedJoint>
        </gazebo>

        <!-- ═══ GAZEBO: Material ═════════════════════════════════════════════ -->
        <gazebo reference="lidar_3d_link">
            <material>Gazebo/DarkGrey</material>
        </gazebo>

        <!-- ═══ GAZEBO: Sensor GPU LiDAR 3D (Velodyne VLP-16 preset) ════════
             Topik Gazebo: /points (PointCloudPacked) dan /points/scan (LaserScan)
        -->
        <gazebo reference="lidar_3d_link">
            <sensor name="lidar_3d" type="gpu_lidar">
                <pose>0 0 ${lidar_height/2} 0 0 0</pose>
                <always_on>true</always_on>
                <visualize>true</visualize>
                <update_rate>10</update_rate>
                <topic>/points</topic>
                <gz:frame_id>lidar_3d_link</gz:frame_id>
                <lidar>
                    <scan>
                        <!-- Horizontal: 360° penuh, 720 sample (0.5° per step) -->
                        <horizontal>
                            <samples>720</samples>
                            <resolution>1</resolution>
                            <min_angle>${-PI}</min_angle>
                            <max_angle>${PI}</max_angle>
                        </horizontal>
                        <!-- Vertical: 16 channel VLP-16, ±15° -->
                        <vertical>
                            <samples>16</samples>
                            <resolution>1</resolution>
                            <min_angle>-0.261799</min_angle>  <!-- -15° dalam radian -->
                            <max_angle>0.261799</max_angle>   <!-- +15° dalam radian -->
                        </vertical>
                    </scan>
                    <range>
                        <min>0.100</min>
                        <max>100.0</max>
                        <resolution>0.01</resolution>
                    </range>
                    <noise>
                        <type>gaussian</type>
                        <mean>0.0</mean>
                        <stddev>0.008</stddev>
                    </noise>
                </lidar>
            </sensor>
        </gazebo>
    </xacro:macro>

</robot>
