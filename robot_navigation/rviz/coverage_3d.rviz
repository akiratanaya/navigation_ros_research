Panels:
  - Class: rviz_common/Displays
    Help Height: 78
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Robot & SLAM1
        - /3D Terrain Analysis1
        - /Fields2Cover Coverage1
        - /CMU Local Navigation1
        - /Footprint Swept Trail1
      Splitter Ratio: 0.5
    Tree Height: 650
  - Class: rviz_common/Selection
    Name: Selection
  - Class: rviz_common/Tool Properties
    Expanded:
      - /2D Goal Pose1
      - /Publish Point1
    Name: Tool Properties
    Splitter Ratio: 0.588679
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5

Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 50
      Reference Frame: <Fixed Frame>
      Value: true

    - Class: rviz_common/Group
      Displays:
        - Class: rviz_default_plugins/RobotModel
          Collision Enabled: false
          Description File: ""
          Description Source: Topic
          Description Topic:
            Depth: 5
            Durability Policy: Transient Local
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /robot_description
          Enabled: true
          Name: RobotModel
          TF Prefix: ""
          Update Interval: 0
          Value: true
          Visual Enabled: true

        - Class: rviz_default_plugins/TF
          Enabled: true
          Frame Timeout: 15
          Frames:
            All Enabled: false
            base_footprint:
              Value: true
            lidar_3d_link:
              Value: true
            map:
              Value: true
            odom:
              Value: true
            vehicle:
              Value: true
          Marker Scale: 0.4
          Name: TF
          Show Arrows: true
          Show Axes: true
          Show Names: false
          Update Interval: 0
          Value: true

        - Alpha: 0.65
          Autocompute Intensity Bounds: true
          Autocompute Value Bounds:
            Max Value: 10
            Min Value: -10
            Value: true
          Axis: Z
          Channel Name: intensity
          Class: rviz_default_plugins/PointCloud2
          Color: 255; 255; 255
          Color Transformer: AxisColor
          Decay Time: 0
          Enabled: true
          Invert Rainbow: false
          Name: Pre-loaded 3D Map (PCD)
          Position Transformer: XYZ
          Selectable: true
          Size (Pixels): 2
          Size (m): 0.03
          Style: Points
          Topic:
            Depth: 5
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /cloud_pcd
          Use Fixed Frame: true
          Use rainbow: true
          Value: true

        - Alpha: 0.8
          Autocompute Intensity Bounds: true
          Autocompute Value Bounds:
            Max Value: 10
            Min Value: -10
            Value: true
          Axis: Z
          Channel Name: intensity
          Class: rviz_default_plugins/PointCloud2
          Color: 255; 255; 255
          Color Transformer: AxisColor
          Decay Time: 1000
          Enabled: false
          Invert Rainbow: false
          Name: LIO-SAM Registered Map
          Position Transformer: XYZ
          Selectable: true
          Size (Pixels): 3
          Size (m): 0.04
          Style: Points
          Topic:
            Depth: 5
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /lio_sam/mapping/cloud_registered
          Use Fixed Frame: true
          Use rainbow: true
          Value: true

        - Alpha: 1
          Buffer Length: 1
          Class: rviz_default_plugins/Path
          Color: 255; 215; 0
          Enabled: true
          Head Diameter: 0.3
          Head Length: 0.2
          Length: 0.3
          Line Style: Lines
          Line Width: 0.04
          Name: LIO-SAM SLAM Path
          Offset:
            X: 0
            Y: 0
            Z: 0
          Pose Color: 255; 85; 255
          Pose Style: None
          Radius: 0.03
          Topic:
            Depth: 5
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /lio_sam/mapping/path
          Value: true
      Enabled: true
      Name: Robot & SLAM

    - Class: rviz_common/Group
      Displays:
        - Alpha: 0.85
          Autocompute Intensity Bounds: true
          Autocompute Value Bounds:
            Max Value: 10
            Min Value: -10
            Value: true
          Axis: Z
          Channel Name: intensity
          Class: rviz_default_plugins/PointCloud2
          Color: 255; 255; 255
          Color Transformer: Intensity
          Decay Time: 0
          Enabled: true
          Invert Rainbow: false
          Name: 3D Terrain Analysis Map
          Position Transformer: XYZ
          Selectable: true
          Size (Pixels): 3
          Size (m): 0.06
          Style: Flat Squares
          Topic:
            Depth: 5
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /terrain_map
          Use Fixed Frame: true
          Use rainbow: true
          Value: true
      Enabled: true
      Name: 3D Terrain Analysis

    - Class: rviz_common/Group
      Displays:
        - Alpha: 1.0
          Class: rviz_default_plugins/Polygon
          Color: 255; 165; 0
          Enabled: true
          Name: Field Boundary
          Topic:
            Depth: 5
            Durability Policy: Transient Local
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /field_boundary
          Value: true

        - Class: rviz_default_plugins/Marker
          Enabled: true
          Name: Field Boundary Preview
          Namespaces: {}
          Topic:
            Depth: 5
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /field_boundary_preview
          Value: true

        - Alpha: 0.95
          Buffer Length: 1
          Class: rviz_default_plugins/Path
          Color: 0; 200; 255
          Enabled: true
          Head Diameter: 0.3
          Head Length: 0.2
          Length: 0.3
          Line Style: Lines
          Line Width: 0.05
          Name: Fields2Cover Global Path
          Offset:
            X: 0
            Y: 0
            Z: 0.05
          Pose Color: 255; 255; 255
          Pose Style: None
          Radius: 0.03
          Topic:
            Depth: 5
            Durability Policy: Transient Local
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /coverage_path
          Value: true

        - Class: rviz_default_plugins/MarkerArray
          Enabled: true
          Name: Coverage Markers
          Namespaces: {}
          Topic:
            Depth: 5
            Durability Policy: Transient Local
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /coverage_markers
          Value: true
      Enabled: true
      Name: Fields2Cover Coverage

    - Class: rviz_common/Group
      Displays:
        - Class: rviz_default_plugins/Marker
          Enabled: true
          Name: Active Lookahead Target
          Namespaces: {}
          Topic:
            Depth: 5
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /cmu_coverage/target_marker
          Value: true

        - Alpha: 1
          Color: 255; 50; 50
          Class: rviz_default_plugins/PointStamped
          Enabled: true
          History Length: 1
          Name: CMU Waypoint
          Radius: 0.25
          Topic:
            Depth: 5
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /way_point
          Value: true

        - Alpha: 1.0
          Buffer Length: 1
          Class: rviz_default_plugins/Path
          Color: 50; 255; 50
          Enabled: true
          Head Diameter: 0.3
          Head Length: 0.2
          Length: 0.3
          Line Style: Lines
          Line Width: 0.07
          Name: Remaining Active Path
          Offset:
            X: 0
            Y: 0
            Z: 0.06
          Pose Color: 255; 85; 255
          Pose Style: None
          Radius: 0.03
          Topic:
            Depth: 5
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /cmu_coverage/active_path
          Value: true

        - Alpha: 1
          Buffer Length: 1
          Class: rviz_default_plugins/Path
          Color: 255; 120; 0
          Enabled: true
          Head Diameter: 0.3
          Head Length: 0.2
          Length: 0.3
          Line Style: Lines
          Line Width: 0.08
          Name: CMU Terrain Conforming Local Path
          Offset:
            X: 0
            Y: 0
            Z: 0.04
          Pose Color: 255; 85; 255
          Pose Style: None
          Radius: 0.03
          Topic:
            Depth: 5
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /path
          Value: true
      Enabled: true
      Name: CMU Local Navigation

    - Class: rviz_common/Group
      Displays:
        - Class: rviz_default_plugins/Marker
          Enabled: true
          Name: Real-time Swept Footprint
          Namespaces: {}
          Topic:
            Depth: 10
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /coverage_swept_footprint
          Value: true
      Enabled: true
      Name: Footprint Swept Trail

  Enabled: true
  Global Options:
    Background Color: 45; 45; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /initialpose
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /goal_pose
    - Class: rviz_default_plugins/PublishPoint
      Single click: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /clicked_point
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 16.0
      Focal Point:
        X: 0.0
        Y: 0.0
        Z: 0.5
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 0.65
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz)
      Yaw: 1.57
